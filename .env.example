# Self-hosted Supabase (Postgres + Auth + REST), running as containers in
# docker-compose.yml. These are generated automatically by scripts/install.sh on
# first run — leave them blank.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL the browser reaches this app at. Apache fronts both the app and the
# auth/rest gateway on this one origin (see deploy/apache-thinkAI.conf) — set this
# before running scripts/install.sh, it gets baked into the browser bundle at build time.
VITE_SUPABASE_URL=https://thinkAI.taghawi-nejad.de

# AI providers
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
